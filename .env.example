# Copy to .env before starting docker compose. Do not commit the resulting .env file.
POSTGRES_DB=interview_guide
POSTGRES_USER=interview_guide
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

DB_URL=jdbc:postgresql://localhost:5432/interview_guide
DB_USERNAME=interview_guide
DB_PASSWORD=replace-with-the-same-local-postgres-password

REDIS_HOST=localhost
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-with-a-local-access-key
S3_SECRET_KEY=replace-with-a-local-secret-key
S3_BUCKET=interview-guide
APP_AI_CONFIG_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

